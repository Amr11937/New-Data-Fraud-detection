# --- Database (unchanged from PCRF) ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- S3 ingestion (replaces the old S3-event Lambda trigger) ---
INGEST_S3_BUCKET=your-pcrf-bucket
INGEST_S3_RAW_PREFIX=raw/
INGEST_S3_PROCESSED_PREFIX=processed/
INGEST_POLL_INTERVAL_SECONDS=300

# --- Daily report email (replaces the old scheduled report Lambda) ---
SES_SENDER_EMAIL=
REPORT_RECIPIENTS=
HIGH_RISK_THRESHOLD=70
MAX_REPORT_ROWS=200
DAILY_REPORT_HOUR_UTC=10
DAILY_REPORT_MINUTE_UTC=30

# --- AWS region (used by boto3 for both S3 and SES) ---
AWS_REGION=us-east-1
